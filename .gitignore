# Python
__pycache__/
*.py[cod]
.venv/

# pasta local data store (runtime workspace files). Copies of pasta's own workspace and its event
# log under `snapshot/` are force-added anyway, by hand with `just commit-workspace`.
.pasta-data/

# test / tooling caches
.pytest_cache/
.testmondata*

# Claude worktrees and settings
.claude/worktrees
.claude/settings.local.json
.mcp.json

# Sphinx build output
docsite/_build/html/**
!docsite/_build/html/.gitkeep
docsite/apidocs/
docsite/page-types/

# graphify output
graphify-out/cost.json
graphify-out/cache/
graphify-out/*

# debug
hmr_debug.log
